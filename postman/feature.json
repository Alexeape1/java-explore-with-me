  "item": [
    {
      "name": "Create location",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Ответ должен содержать код 201\", function () {\r",
              "    pm.response.to.have.status(201);\r",
              "});\r",
              "\r",
              "pm.test(\"Ответ содержит id\", function () {\r",
              "    const json = pm.response.json();\r",
              "    pm.expect(json.id).to.be.a(\"number\");\r",
              "});\r",
              "\r",
              "pm.test(\"Название сохранено\", function () {\r",
              "    const json = pm.response.json();\r",
              "    pm.expect(json.name).to.eql(\"Moscow Center\");\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"name\": \"Moscow Center\",\r\n    \"lat\": 55.7558,\r\n    \"lon\": 37.6176,\r\n    \"radius\": 10\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:8080/admin/locations",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8080",
          "path": [
            "admin",
            "locations"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get locations",
      "event": [
