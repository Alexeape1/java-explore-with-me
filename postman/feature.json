          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Ответ должен содержать код 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Ответ является массивом\", function () {\r",
              "    pm.expect(pm.response.json()).to.be.an(\"array\");\r",
              "});\r",
              "\r",
              "pm.test(\"Список содержит хотя бы одну локацию\", function () {\r",
              "    pm.expect(pm.response.json().length).to.be.greaterThan(0);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
